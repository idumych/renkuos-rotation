+/*!	Rotated variant of _CopyToFront().
+	\a src points at logical pixel (x, y) of a B_RGBA32 buffer, the rectangle
+	is given in logical (rotated) coordinates. It is written to the physical
+	front buffer turned by fRotation degrees clockwise.
+
+	The loop walks the destination row by row, so writes to the (usually
+	write-combined) frame buffer stay sequential; the strided accesses are
+	reads from the back buffer in normal memory instead.
+*/
+void
+HWInterface::_CopyToFrontRotated(uint8* src, uint32 srcBPR, int32 x, int32 y,
+	int32 right, int32 bottom) const
+{
+	RenderingBuffer* frontBuffer = FrontBuffer();
+	RenderingBuffer* backBuffer = BackBuffer();
+	if (frontBuffer == NULL || backBuffer == NULL || right < x || bottom < y)
+		return;
+
+	// logical screen size
+	const int32 width = backBuffer->Width();
+	const int32 height = backBuffer->Height();
+
+	// destination rectangle in physical coordinates, plus how far to step
+	// in the source for each physical pixel to the right
+	int32 dstLeft, dstTop, dstRight, dstBottom;
+	int32 srcStep;
+	switch (fRotation) {
+		case 90:
+			// logical (lx, ly) -> physical (height - 1 - ly, lx)
+			dstLeft = height - 1 - bottom;
+			dstRight = height - 1 - y;
+			dstTop = x;
+			dstBottom = right;
+			srcStep = -(int32)srcBPR;
+			break;
+		case 180:
+			// logical (lx, ly) -> physical (width - 1 - lx, height - 1 - ly)
+			dstLeft = width - 1 - right;
+			dstRight = width - 1 - x;
+			dstTop = height - 1 - bottom;
+			dstBottom = height - 1 - y;
+			srcStep = -4;
+			break;
+		case 270:
+			// logical (lx, ly) -> physical (ly, width - 1 - lx)
+			dstLeft = y;
+			dstRight = bottom;
+			dstTop = width - 1 - right;
+			dstBottom = width - 1 - x;
+			srcStep = (int32)srcBPR;
+			break;
+		default:
+			return;
+	}
+
+	// never write outside the physical frame buffer
+	if (dstLeft < 0 || dstTop < 0
+		|| dstRight >= (int32)frontBuffer->Width()
+		|| dstBottom >= (int32)frontBuffer->Height()) {
+		return;
+	}
+
+	uint8* dst = (uint8*)frontBuffer->Bits();
+	const uint32 dstBPR = frontBuffer->BytesPerRow();
+	const color_space space = frontBuffer->ColorSpace();
+
+	for (int32 py = dstTop; py <= dstBottom; py++) {
+		// source pixel that lands on (dstLeft, py)
+		const uint8* s;
+		switch (fRotation) {
+			case 90:
+				// lx = py; px == dstLeft means ly == bottom
+				s = src + (bottom - y) * srcBPR + (py - x) * 4;
+				break;
+			case 180:
+				// ly = height - 1 - py; px == dstLeft means lx == right
+				s = src + (height - 1 - py - y) * srcBPR + (right - x) * 4;
+				break;
+			default:
+				// 270: lx = width - 1 - py; px == dstLeft means ly == y
+				s = src + (width - 1 - py - x) * 4;
+				break;
+		}
+
+		switch (space) {
+			case B_RGB32:
+			case B_RGBA32:
+			{
+				uint32* d = (uint32*)(dst + py * dstBPR) + dstLeft;
+				for (int32 px = dstLeft; px <= dstRight; px++) {
+					*d++ = *(const uint32*)s;
+					s += srcStep;
+				}
+				break;
+			}
+			case B_RGB16:
+			{
+				uint16* d = (uint16*)(dst + py * dstBPR) + dstLeft;
+				for (int32 px = dstLeft; px <= dstRight; px++) {
+					*d++ = (uint16)(((s[2] & 0xf8) << 8)
+						| ((s[1] & 0xfc) << 3) | (s[0] >> 3));
+					s += srcStep;
+				}
+				break;
+			}
+			case B_RGB15:
+			case B_RGBA15:
+			{
+				uint16* d = (uint16*)(dst + py * dstBPR) + dstLeft;
+				for (int32 px = dstLeft; px <= dstRight; px++) {
+					*d++ = (uint16)(((s[2] & 0xf8) << 7)
+						| ((s[1] & 0xf8) << 2) | (s[0] >> 3));
+					s += srcStep;
+				}
+				break;
+			}
+			case B_RGB24:
+			{
+				uint8* d = dst + py * dstBPR + dstLeft * 3;
+				for (int32 px = dstLeft; px <= dstRight; px++) {
+					d[0] = s[0];
+					d[1] = s[1];
+					d[2] = s[2];
+					d += 3;
+					s += srcStep;
+				}
+				break;
+			}
+			default:
+				fprintf(stderr, "HWInterface: display rotation is not "
+					"supported in color space 0x%x, use 32 bit\n", space);
+				return;
+		}
+	}
+}
+
+
 /*!	The object must be locked
 */
